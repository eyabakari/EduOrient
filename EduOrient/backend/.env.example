APP_NAME=ProLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# CORS (SPA Vite : localhost:5173). Requis si supports_credentials=true dans config/cors.php
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sanctum (domaines « stateful » pour cookies SPA — optionnel si vous utilisez uniquement Bearer)
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000,::1

LOG_CHANNEL=stack
LOG_LEVEL=debug



# Anciennes variables OpenAI — conserver seulement si vous utilisez encore le service OpenAI ailleurs.
# OPENAI_API_KEY=
# OPENAI_MATCHING_MODEL=gpt-4o-mini
# OPENAI_MATCHING_TIMEOUT=20
# OPENAI_MATCHING_MIN_SCORE=15

# Gemini (Google AI) matching configuration
# GEMINI_API_KEY=
# GEMINI_MATCHING_HOST=https://generativelanguage.googleapis.com
# GEMINI_MATCHING_API_VERSION=v1beta
# GEMINI_MATCHING_MODEL=gemini-1.5-flash
# GEMINI_MATCHING_TIMEOUT=20
# GEMINI_MATCHING_MIN_SCORE=15

DB_CONNECTION=sqlite

# Reverb (temps réel messagerie) — Vite lit ces clés via frontend/vite.config.js (envDir = backend)
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=127.0.0.1
# REVERB_PORT=8080
# REVERB_SCHEME=http
# VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
# VITE_REVERB_HOST=127.0.0.1
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http
# false tant que « php artisan reverb:start » n’est pas lancé (sinon erreurs WebSocket dans la console).
# VITE_REVERB_ENABLED=false

# Mail (tests : Mailtrap https://mailtrap.io — copier Username / Password de l’inbox SMTP)
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# Une seule valeur, sans guillemets imbriqués (sinon Dotenv invalide → 500 sur toute l’API).
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Alternative Gmail (moins recommandé pour le dev) :
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=votre@gmail.com
# MAIL_PASSWORD=mot_de_passe_application
# MAIL_ENCRYPTION=tls
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
HUGGINGFACE_API_KEY=
